# Copy to deploy/web.env (git-ignored) and fill in. Only these three public
# values are allowed; build_web.ps1 refuses any other key and any secret key.
# Everything here is compiled into the public web bundle.

# Supabase project URL (Dashboard > Project Settings > API), https only.
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...) or the legacy anon key. Never the
# secret / service_role key.
SUPABASE_PUBLISHABLE_KEY=

# Public OAuth client of Secondhand (Dashboard > Authentication > OAuth Apps).
KAO_ID_CLIENT_ID=
