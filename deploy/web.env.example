# Copy to deploy/web.env (git-ignored) and fill in. Only these five public
# values are allowed; build_web.ps1 refuses any other key and any secret key.
# Everything here is compiled into the public web bundle.

# Kao ID Supabase project URL (Dashboard > Project Settings > API), https only.
# Also the OAuth issuer Secondhand signs in with.
SUPABASE_URL=https://<kao-id-project-ref>.supabase.co

# Kao ID publishable key (sb_publishable_...) or the legacy anon key. Never the
# secret / service_role key.
SUPABASE_PUBLISHABLE_KEY=

# Public OAuth client of Secondhand (Kao ID Dashboard > Authentication > OAuth Apps).
KAO_ID_CLIENT_ID=

# Secondhand's own Supabase project, where marketplace data lives.
SECONDHAND_SUPABASE_URL=https://<secondhand-project-ref>.supabase.co

# Secondhand publishable key (Secondhand Dashboard > Project Settings > API keys).
SECONDHAND_SUPABASE_PUBLISHABLE_KEY=
